# PostgreSQL connection (psycopg3 driver)
DATABASE_URL=postgresql+psycopg://lo2ta:lo2ta@localhost:5432/lo2ta

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173"]

UPLOAD_DIR=uploads
MAX_IMAGE_MB=8
MAX_VIDEO_MB=50

# First superuser created by `python -m app.seed`
FIRST_MANAGER_EMAIL=manager@lo2ta.com
FIRST_MANAGER_PASSWORD=ChangeMe123!
FIRST_MANAGER_NAME=مدير المتجر
