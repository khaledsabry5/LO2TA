# ==============================================================
# YSN Store - Production Environment Configuration (.env.example)
# Domain: ysn-store.cloud
# ==============================================================

# --------------------------------------------------------------
# Core Application Settings (Previously configured on Railway)
# --------------------------------------------------------------
APP_NAME="YSN Store API"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection URL:
# Option 1: Use internal PostgreSQL container from docker-compose (default)
DATABASE_URL=postgresql://lo2ta:lo2ta_password_secure@db:5432/lo2ta
# Option 2: Use external PostgreSQL (e.g. Railway, Supabase, Neon)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Initial Store Manager / Superadmin Account (seeded automatically on startup)
FIRST_MANAGER_NAME="مدير المتجر"
FIRST_MANAGER_EMAIL=lo2tastore2026@gmail.com
FIRST_MANAGER_PASSWORD=ChangeThisPassword123!

# Cloudinary Storage Credentials (Cloud image & video hosting)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Brevo (Sendinblue) Email API Key
BREVO_API_KEY=your_brevo_api_key

# --------------------------------------------------------------
# Security & JWT Authentication
# --------------------------------------------------------------
# Generate a secure random secret key with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace_with_a_very_long_secure_random_secret_key_here
JWT_ALGORITHM=HS256

# Allowed CORS Origins (JSON array format)
CORS_ORIGINS=["https://ysn-store.cloud","https://www.ysn-store.cloud","http://localhost:5173"]

# --------------------------------------------------------------
# Email Sender Settings
# --------------------------------------------------------------
SMTP_FROM_EMAIL=lo2tastore2026@gmail.com
SMTP_FROM_NAME="YSN Store"

# --------------------------------------------------------------
# Upload & Media Limits
# --------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_IMAGE_MB=8
MAX_VIDEO_MB=50

# --------------------------------------------------------------
# Local PostgreSQL Service (used by docker-compose db service)
# --------------------------------------------------------------
POSTGRES_USER=lo2ta
POSTGRES_PASSWORD=lo2ta_password_secure
POSTGRES_DB=lo2ta

# --------------------------------------------------------------
# VPS Domain & SSL Configuration (used by setup.sh & Nginx)
# --------------------------------------------------------------
DOMAIN_NAME=ysn-store.cloud
CERTBOT_EMAIL=lo2tastore2026@gmail.com
